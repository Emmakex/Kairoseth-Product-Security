NODE_ENV=development
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=kairoseth_product_security
WORKER_ID=local-worker
WORKER_POLL_MS=2000
JOB_LEASE_MS=30000
WORKER_ONCE=false

# Internal Product Security API — server-side only.
# Must match Kairoseth Platform PRODUCT_SECURITY_SERVICE_SECRET.
# Generate with: openssl rand -base64 48
PRODUCT_SECURITY_SERVICE_SECRET=replace-with-at-least-32-bytes-of-random-data
PRODUCT_SECURITY_API_HOST=0.0.0.0
PRODUCT_SECURITY_API_PORT=8787

# GitHub App connector — server-side only. Never commit real values.
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_API_BASE_URL=https://api.github.com
