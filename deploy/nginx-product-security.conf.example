# Kairoseth Product Security runtime reverse-proxy example.
# Replace the server_name and TLS certificate paths for the deployed runtime origin.
# The Node API listens only on 127.0.0.1:8787 on the host through Docker Compose.

server {
    listen 443 ssl http2;
    server_name product-security-runtime.kairoseth.com;

    ssl_certificate /etc/letsencrypt/live/product-security-runtime.kairoseth.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/product-security-runtime.kairoseth.com/privkey.pem;

    client_max_body_size 128k;

    location = /healthz {
        proxy_pass http://127.0.0.1:8787/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-store" always;
    }

    # GitHub must reach this endpoint directly. HMAC validation happens against
    # the raw request body before JSON parsing inside Product Security.
    location = /webhooks/github {
        proxy_pass http://127.0.0.1:8787/webhooks/github;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Kairoseth Platform calls these routes server-to-server. Every request is
    # independently authenticated by a short-lived scoped HMAC service token.
    location ^~ /internal/product-security/v1/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 404;
    }
}
