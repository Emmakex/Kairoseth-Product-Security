{
  "name": "@kairoseth/product-security",
  "version": "0.1.0",
  "private": true,
  "description": "Kairoseth Product Security engine and CRA OS runtime",
  "engines": { "node": ">=22 <23" },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker.ts --once",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "mongodb": "^6.20.0",
    "pino": "^9.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.2",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.4"
  }
}
